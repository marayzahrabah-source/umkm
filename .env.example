# Supabase Configuration
# Dapatkan nilai ini dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# HANYA untuk server-side (Server Actions / Route Handlers).
# JANGAN PERNAH mengekspos key ini ke browser atau prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL (opsional, untuk redirect auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
